@using YaaraFramesGifts.DTOs

<a class="shop-category-card" href="@($"/shop?category={Uri.EscapeDataString(Category.Slug)}")"
   aria-label="@($"Explore {Category.Name}")">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="" loading="lazy" />
    }
    <span class="shop-category-shade"></span>
    <span class="shop-category-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25">
            <path d="M16 3.5c2.4 4.8 4.3 6.7 9.2 9.1-4.9 2.4-6.8 4.3-9.2 9.2-2.4-4.9-4.3-6.8-9.2-9.2 4.9-2.4 6.8-4.3 9.2-9.1Z" />
            <path d="M24.5 21c1.2 2.5 2.1 3.4 4.5 4.6-2.4 1.2-3.3 2.1-4.5 4.5-1.2-2.4-2.1-3.3-4.5-4.5 2.4-1.2 3.3-2.1 4.5-4.6Z" />
        </svg>
    </span>
    <span class="shop-category-copy">
        <strong>@Category.Name</strong>
        <span class="shop-category-description">@Category.Description</span>
        <span class="shop-category-link">Explore <span aria-hidden="true">↗</span></span>
    </span>
</a>

@code {
    [Parameter, EditorRequired]
    public CategoryDto Category { get; set; } = default!;

    [Parameter]
    public string? ImageUrl { get; set; }
}
