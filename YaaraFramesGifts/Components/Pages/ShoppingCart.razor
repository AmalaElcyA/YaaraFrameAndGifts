@page "/cart"
@using System.Globalization
@implements IDisposable
@inject CartSession Cart

<PageTitle>Your gift basket | Yaara Frames &amp; Gifts</PageTitle>

<section class="cart-page section-wrap">
    <p class="eyebrow">A little joy is on its way</p>

    @if (isLoading)
    {
        <div class="cart-page-empty" role="status">
            <p class="eyebrow">One little moment</p>
            <h2>Gathering your gift basket…</h2>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="cart-page-empty" role="alert">
            <span class="product-missing-icon" aria-hidden="true">♡</span>
            <h2>We couldn't load your gift basket.</h2>
            <p>@loadError</p>
            <button class="button button-outline" @onclick="RetryLoadAsync">Try Again</button>
        </div>
    }
    else if (Cart.Cart is { } cart)
    {
        <h1>Your gift basket <span>(@cart.ItemCount @(cart.ItemCount == 1 ? "item" : "items"))</span></h1>

        @if (!string.IsNullOrWhiteSpace(actionError))
        {
            <p class="eyebrow" role="alert">@actionError</p>
        }

        @if (cart.Items.Count == 0)
        {
            <div class="cart-page-empty">
                <svg class="empty-cart-illustration" viewBox="0 0 120 108" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M22 35h76l-6 63H28l-6-63Z" />
                    <path d="M43 37V25a17 17 0 0 1 34 0v12" />
                    <path d="M60 54c-5-9-17-5-14 3 2 6 14 14 14 14s12-8 14-14c3-8-9-12-14-3Z" />
                    <path d="M16 20c5 0 8 3 8 8m72-8c-5 0-8 3-8 8" />
                </svg>
                <p class="eyebrow">A little something is missing</p>
                <h2>Your gift basket is waiting!</h2>
                <p>Fill it with something thoughtful for someone who makes your days special.</p>
                <a class="button button-dark" href="/shop">Start Shopping <span aria-hidden="true">↗</span></a>
            </div>
        }
        else
        {
            <div class="cart-page-layout">
                <div class="cart-page-items" role="list" aria-label="Items in your gift basket">
                    @foreach (var item in cart.Items)
                    {
                        <article class="cart-page-item" role="listitem" @key="item.ProductId">
                            <a class="cart-page-thumbnail" href="@($"/product/{item.ProductId}")"
                               aria-label="@($"View {item.ProductName} details")">
                                <img src="@item.ImageUrl" alt="@item.ProductName" />
                            </a>
                            <div class="cart-page-item-info">
                                <span class="product-category">@item.CategoryName</span>
                                <h2><a href="@($"/product/{item.ProductId}")">@item.ProductName</a></h2>
                                <p>@item.Description</p>
                                <span class="cart-page-unit-price">₹@item.UnitPrice.ToString("N0", CultureInfo.GetCultureInfo("en-IN")) each</span>
                                <div class="cart-page-quantity" role="group" aria-label="@($"Quantity for {item.ProductName}")">
                                    <button aria-label="Decrease quantity" disabled="@(isUpdating || item.Quantity <= 1)"
                                            @onclick="() => UpdateQuantityAsync(item.ProductId, item.Quantity - 1)">−</button>
                                    <span aria-live="polite">@item.Quantity</span>
                                    <button aria-label="Increase quantity" disabled="@(isUpdating || item.Quantity >= 99)"
                                            @onclick="() => UpdateQuantityAsync(item.ProductId, item.Quantity + 1)">+</button>
                                </div>
                            </div>
                            <div class="cart-page-item-actions">
                                <div class="cart-page-line-total">
                                    <span>Line total</span>
                                    <strong>₹@item.LineTotal.ToString("N0", CultureInfo.GetCultureInfo("en-IN"))</strong>
                                </div>
                                <button class="cart-page-remove" disabled="@isUpdating"
                                        aria-label="@($"Remove {item.ProductName} from your gift basket")"
                                        @onclick="() => RemoveItemAsync(item.ProductId)">
                                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <path d="M3 5h14M8 5V3h4v2m3 0-.8 12H5.8L5 5m3 3v6m4-6v6" />
                                    </svg>
                                    Remove
                                </button>
                            </div>
                        </article>
                    }
                    <button class="cart-page-remove" disabled="@isUpdating" @onclick="ClearCartAsync">Clear basket</button>
                </div>

                <aside class="cart-page-summary" aria-label="Order summary">
                    <h2>A little order summary</h2>
                    <p class="cart-summary-item-count">@cart.ItemCount @(cart.ItemCount == 1 ? "lovely find" : "lovely finds") in your basket</p>

                    @if (!cart.IsFreeShippingEligible)
                    {
                        <div class="cart-shipping-nudge" role="status">
                            <p>You’re <strong>₹@ShippingRemaining(cart).ToString("N0", CultureInfo.GetCultureInfo("en-IN"))</strong> away from complimentary delivery.</p>
                            <div class="cart-shipping-progress" role="progressbar"
                                 aria-label="Progress towards free shipping"
                                 aria-valuemin="0" aria-valuemax="100"
                                 aria-valuenow="@ShippingProgress(cart).ToString("0", CultureInfo.InvariantCulture)">
                                <span style="width: @($"{ShippingProgress(cart):0}%")"></span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cart-shipping-unlocked" role="status">
                            <span aria-hidden="true">✦</span>
                            <p>Lovely! You’ve unlocked free shipping.</p>
                        </div>
                    }

                    <div class="cart-summary-row">
                        <span>Subtotal</span>
                        <strong>₹@cart.Subtotal.ToString("N0", CultureInfo.GetCultureInfo("en-IN"))</strong>
                    </div>
                    <div class="cart-summary-row">
                        <span>Shipping</span>
                        <strong>@(cart.ShippingFee == 0 ? "Complimentary" : $"₹{cart.ShippingFee.ToString("N0", CultureInfo.GetCultureInfo("en-IN"))}")</strong>
                    </div>
                    <div class="cart-page-total">
                        <span>Total</span>
                        <strong>₹@cart.GrandTotal.ToString("N0", CultureInfo.GetCultureInfo("en-IN"))</strong>
                    </div>
                    <p class="cart-taxes-note">Taxes included. Final delivery details can be confirmed at checkout.</p>
                    <button class="button cart-checkout-button" disabled aria-describedby="checkout-note">
                        Checkout coming soon
                    </button>
                    <p class="checkout-note" id="checkout-note">We’re preparing a secure checkout experience. No payment will be taken here.</p>
                    <a class="cart-continue-link" href="/shop">Continue Shopping <span aria-hidden="true">↗</span></a>
                </aside>
            </div>
        }
    }
</section>

@code {
    private const decimal FreeShippingThreshold = 999m;
    private bool isLoading = true;
    private bool isUpdating;
    private string? loadError;
    private string? actionError;

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadCartAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RetryLoadAsync()
    {
        isLoading = true;
        loadError = null;
        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        try
        {
            await Cart.InitializeAsync();
            loadError = null;
        }
        catch (YaaraApiException exception)
        {
            loadError = exception.Message;
        }
        catch (HttpRequestException)
        {
            loadError = "We couldn't reach the shop just now. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task UpdateQuantityAsync(int productId, int quantity) =>
        ExecuteCartActionAsync(() => Cart.UpdateQuantityAsync(productId, quantity));

    private Task RemoveItemAsync(int productId) =>
        ExecuteCartActionAsync(() => Cart.RemoveItemAsync(productId));

    private Task ClearCartAsync() => ExecuteCartActionAsync(() => Cart.ClearAsync());

    private async Task ExecuteCartActionAsync(Func<Task> action)
    {
        isUpdating = true;
        actionError = null;
        try
        {
            await action();
        }
        catch (YaaraApiException exception)
        {
            actionError = exception.Message;
        }
        catch (HttpRequestException)
        {
            actionError = "We couldn't update your basket just now. Please try again.";
        }
        finally
        {
            isUpdating = false;
        }
    }

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

    private static decimal ShippingRemaining(CartDto cart) =>
        Math.Max(0m, FreeShippingThreshold - cart.Subtotal);

    private static decimal ShippingProgress(CartDto cart) =>
        cart.Subtotal == 0
            ? 0
            : Math.Min(100m, cart.Subtotal / FreeShippingThreshold * 100m);

    public void Dispose() => Cart.Changed -= OnCartChanged;
}
