@using System.Globalization
@using YaaraFramesGifts.DTOs
@inject CartSession Cart

<article class="featured-product-card">
    <a class="featured-product-image" href="@($"/product/{Product.Id}")"
       aria-label="@($"View details for {Product.Name}")">
        <img src="@Product.ImageUrl" alt="@Product.Name" loading="lazy" />
        @if (!string.IsNullOrWhiteSpace(Product.Badge))
        {
            <span class="featured-product-badge">@Product.Badge</span>
        }
    </a>
    <div class="featured-product-info">
        <span class="product-category">@Product.Category.Name</span>
        <a class="featured-product-name" href="@($"/product/{Product.Id}")">@Product.Name</a>
        <p class="featured-product-description">@Product.Description</p>
        <div class="featured-product-bottom">
            <strong>₹@Product.Price.ToString("N0", CultureInfo.GetCultureInfo("en-IN"))</strong>
            <div class="featured-product-actions">
                <a class="featured-product-details" href="@($"/product/{Product.Id}")">View details</a>
                <button class="featured-product-add" disabled="@isAdding" @onclick="AddToCartAsync">
                    @(isAdding ? "Adding…" : "Add to Cart") <span aria-hidden="true">+</span>
                </button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(addMessage))
        {
            <p class="product-add-feedback" role="status">@addMessage</p>
        }
        @if (!string.IsNullOrWhiteSpace(addError))
        {
            <p class="eyebrow" role="alert">@addError</p>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public ProductDto Product { get; set; } = default!;

    private bool isAdding;
    private string? addMessage;
    private string? addError;

    private async Task AddToCartAsync()
    {
        isAdding = true;
        addMessage = null;
        addError = null;
        try
        {
            await Cart.AddItemAsync(Product.Id);
            addMessage = $"{Product.Name} has been added to your bag.";
        }
        catch (YaaraApiException exception)
        {
            addError = exception.Message;
        }
        catch (HttpRequestException)
        {
            addError = "We couldn't reach the shop just now. Please try again.";
        }
        finally
        {
            isAdding = false;
        }
    }
}
