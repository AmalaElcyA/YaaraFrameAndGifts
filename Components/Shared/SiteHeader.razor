@implements IAsyncDisposable
@inject CartService Cart
@inject IJSRuntime JS

<div class="announcement-bar">
    <span class="announcement-sparkle" aria-hidden="true">✦</span>
    <span>Free shipping on orders from ₹999</span>
    <span class="announcement-sparkle" aria-hidden="true">✦</span>
</div>

<header class="site-header">
    <a class="brand brand-logo-shell" href="/" aria-label="Yaara Frames and Gifts home">
        <img class="brand-logo" src="/images/yaara-logo.jpg" alt="Yaara Frames &amp; Gifts" />
    </a>

    <nav class="desktop-site-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/categories">Categories</a>
        <a href="/#shop">Shop</a>
        <a href="/#contact">Contact</a>
    </nav>

    <div class="header-actions">
        <a class="header-cart" href="/cart" aria-label="@($"Shopping cart, {Cart.ItemCount} items. View your cart.")">
            <svg class="bag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M5 8.5h14l-1 12H6z" />
                <path d="M9 9V6a3 3 0 0 1 6 0v3" />
            </svg>
            <span class="cart-label">Your bag</span>
            <span class="cart-count" aria-live="polite" aria-atomic="true">@Cart.ItemCount</span>
        </a>

        <button @ref="menuToggleButton" class="mobile-menu-toggle"
                aria-label="@(isMenuOpen ? "Close navigation menu" : "Open navigation menu")"
                aria-controls="mobile-navigation" aria-expanded="@isMenuOpen"
                @onclick="ToggleMenu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                @if (isMenuOpen)
                {
                    <path d="m6 6 12 12M18 6 6 18" />
                }
                else
                {
                    <path d="M4 7h16M4 12h16M4 17h16" />
                }
            </svg>
        </button>
    </div>
</header>

@if (isMenuOpen)
{
    <button class="mobile-nav-overlay" aria-label="Close navigation menu" @onclick="CloseMobileMenu"></button>
}

<aside @ref="mobileNavigation" id="mobile-navigation"
       class="mobile-nav-panel @(isMenuOpen ? "is-open" : "")"
       role="dialog" aria-modal="true" aria-label="Mobile navigation"
       aria-hidden="@(!isMenuOpen)" inert="@(!isMenuOpen)">
    <div class="mobile-nav-heading">
        <a class="brand-logo-shell mobile-nav-brand" href="/" aria-label="Yaara Frames and Gifts home"
           @onclick="CloseMobileMenu">
            <img class="brand-logo" src="/images/yaara-logo.jpg" alt="Yaara Frames &amp; Gifts" />
        </a>
        <button class="mobile-nav-close" aria-label="Close navigation menu" @onclick="CloseMobileMenu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="m6 6 12 12M18 6 6 18" />
            </svg>
        </button>
    </div>
    <nav class="mobile-nav-links" aria-label="Mobile main navigation">
        <a href="/" @onclick="CloseMobileMenu"><span>01</span>Home</a>
        <a href="/categories" @onclick="CloseMobileMenu"><span>02</span>Categories</a>
        <a href="/#shop" @onclick="CloseMobileMenu"><span>03</span>Shop</a>
        <a href="/#contact" @onclick="CloseMobileMenu"><span>04</span>Contact</a>
    </nav>
    <p class="mobile-nav-note">Thoughtful gifts, made personal <span aria-hidden="true">♡</span></p>
</aside>

@code {
    private ElementReference menuToggleButton;
    private ElementReference mobileNavigation;
    private IJSObjectReference? jsModule;
    private DotNetObjectReference<SiteHeader>? dotNetReference;
    private bool isMenuOpen;
    private bool wasMenuOpen;

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mobile-nav.js");

        if (isMenuOpen && !wasMenuOpen)
        {
            dotNetReference ??= DotNetObjectReference.Create(this);
            await jsModule.InvokeVoidAsync("activateMenu", mobileNavigation, dotNetReference);
        }
        else if (!isMenuOpen && wasMenuOpen)
        {
            await jsModule.InvokeVoidAsync("deactivateMenu", mobileNavigation);
            await menuToggleButton.FocusAsync();
        }

        wasMenuOpen = isMenuOpen;
    }

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);
    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMobileMenu() => isMenuOpen = false;

    [JSInvokable]
    public Task CloseMobileMenuFromKeyboard() => InvokeAsync(() =>
    {
        isMenuOpen = false;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Cart.Changed -= OnCartChanged;

        if (jsModule is not null)
        {
            try
            {
                if (wasMenuOpen)
                {
                    await jsModule.InvokeVoidAsync("deactivateMenu", mobileNavigation);
                }

                await jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dotNetReference?.Dispose();
    }
}
