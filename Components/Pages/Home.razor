@page "/"
@using YaaraFramesGifts.Models
@inject ProductCatalog ProductCatalog

<PageTitle>Yaara Frames &amp; Gifts | Gifts Made With Love</PageTitle>

<section class="hero home-hero">
    <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-mark"></span> Thoughtful gifting, from our hands to theirs</p>
        <h1>Gifts Made<br /><em>With Love</em></h1>
        <p class="hero-description">Thoughtfully crafted personalized gifts that turn your special moments into memories worth keeping forever.</p>
        <div class="hero-actions">
            <a class="button button-dark" href="/shop">Shop Now <span aria-hidden="true">↗</span></a>
            <a class="button button-outline" href="/categories">Explore Categories <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-note">
            <span class="hero-note-mark" aria-hidden="true">✦</span>
            <p><strong>A gift that feels like them.</strong><br />Personalised details, beautifully wrapped.</p>
        </div>
    </div>
    <div class="hero-visual">
        <img src="https://images.unsplash.com/photo-1513201099705-a9746e1e201f?auto=format&amp;fit=crop&amp;w=1400&amp;q=88"
             alt="Hand-wrapped gifts with a soft ribbon, ready for a special occasion" fetchpriority="high" />
        <div class="hero-sticker" aria-label="Made just for you">
            <span>made</span><strong>just<br />for you</strong><span>with love ♡</span>
        </div>
        <div class="hero-caption"><span class="caption-line"></span>A little joy, wrapped with care</div>
    </div>
</section>

<section class="homepage-categories section-wrap" id="categories">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Good things for every kind of moment</p>
            <h2>Find their kind of <em>wonderful.</em></h2>
        </div>
        <a class="text-link" href="/categories">Browse by category <span aria-hidden="true">↗</span></a>
    </div>
    <div class="homepage-category-grid">
        @foreach (var category in ProductCatalog.Categories)
        {
            <ShopCategoryCard Category="category" @key="category.Id" />
        }
    </div>
</section>

<section class="featured-section section-wrap" id="shop">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Picked with a little extra love</p>
            <h2>Little things, <em>big feelings.</em></h2>
        </div>
        <a class="text-link" href="/shop">See all the lovely things <span aria-hidden="true">↗</span></a>
    </div>
    <div class="featured-product-grid">
        @foreach (var product in ProductCatalog.Products.Take(4))
        {
            <FeaturedProductCard Product="product" @key="product.Id" />
        }
    </div>
</section>

<section class="brand-promise section-wrap" id="brand-promise" aria-labelledby="brand-promise-title">
    <div class="brand-promise-heading">
        <p class="eyebrow">The Yaara way</p>
        <h2 id="brand-promise-title">A little more <em>meaning.</em></h2>
    </div>
    <div class="brand-promise-grid">
        <div class="promise-item">
            <span class="promise-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M16 27s-11-6.5-11-14a6 6 0 0 1 11-3 6 6 0 0 1 11 3c0 7.5-11 14-11 14Z" /><path d="M11 16h3l2-4 2 8 2-4h2" /></svg>
            </span>
            <h3>Made With Love</h3>
            <p>Every thoughtful detail is made with care.</p>
        </div>
        <div class="promise-item">
            <span class="promise-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="16" cy="11" r="6" /><path d="M5 28c.8-6 4.5-9 11-9s10.2 3 11 9H5Z" /><path d="m22 7 1.5 1.5L26 6" /></svg>
            </span>
            <h3>Personalized For You</h3>
            <p>Little personal touches that make it theirs.</p>
        </div>
        <div class="promise-item">
            <span class="promise-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 13 16 6l12 7v15H4V13Z" /><path d="M4 13h24M16 6v22M10 6c-4-4 2-6 6 0 4-6 10-4 6 0" /></svg>
            </span>
            <h3>Beautifully Packaged</h3>
            <p>Wrapped with care, ready to make them smile.</p>
        </div>
        <div class="promise-item">
            <span class="promise-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 9h17v15H3zM20 14h5l4 5v5h-9z" /><circle cx="9" cy="25" r="3" /><circle cx="24" cy="25" r="3" /><path d="M7 14h8M7 18h5" /></svg>
            </span>
            <h3>Delivered With Care</h3>
            <p>From our little studio to their doorstep.</p>
        </div>
    </div>
</section>

<section class="homepage-final-cta">
    <div class="homepage-final-cta-inner">
        <span class="cta-ornament" aria-hidden="true">✦</span>
        <p class="eyebrow">For the people who make life lovely</p>
        <h2>Make Every Moment <em>Special</em></h2>
        <p>Find a thoughtful something that says, “I was thinking of you.”</p>
        <a class="button button-dark" href="/shop">Shop Now <span aria-hidden="true">↗</span></a>
    </div>
</section>
